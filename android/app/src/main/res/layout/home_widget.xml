<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/conversation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:text="@string/widget_conversation"
        android:textColor="@color/orange_unbleached"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/phrase_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_phrase"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/blue_kuroi_black"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/phrase_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_phrase"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/blue_kuroi_black"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/phrase_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_phrase"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/blue_kuroi_black"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/phrase_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_phrase"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/blue_kuroi_black"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_empty"
        android:textColor="@color/blue_mysterious_night"
        android:textSize="13sp" />
</LinearLayout>
